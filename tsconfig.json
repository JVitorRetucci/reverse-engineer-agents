{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "Node",
    "outDir": "dist",
    "rootDir": "src",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "baseUrl": "src",
    "paths": {
      "@core/*": ["./core/*"],
      "@domain/*": ["./domain/*"],
      "@application/*": ["./application/*"],
      "@infra/*": ["./infra/*"],
      "@presentation/*": ["./presentation/*"],
    }
  },
  "include": ["src"],
  "exclude": ["node_modules", "dist"]
}