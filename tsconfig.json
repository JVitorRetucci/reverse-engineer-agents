{
  "compilerOptions": {
    "target": "ES2020",
    "module": "NodeNext",
    "moduleResolution": "nodenext",
    "outDir": "dist",
    "rootDir": "src",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "baseUrl": "src",
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "paths": {
      "@root/*": ["./*"],
      "@core/*": ["./core/*"],
      "@domain/*": ["./domain/*"],
      "@agents/*": ["./agents/*"],
      "@services/*": ["./services/*"],
    }
  },
  "include": ["src"],
  "exclude": ["node_modules", "dist"]
}