{
  "compilerOptions": {
    "target": "ES2020",
    "module": "NodeNext",
    "moduleResolution": "nodenext",
    "outDir": "dist",
    "rootDir": "src",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "baseUrl": "src",
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "paths": {
      "@core/*": ["./core/*"],
      "@domain/*": ["./domain/*"],
      "@application/*": ["./application/*"],
      "@infra/*": ["./infra/*"],
      "@presentation/*": ["./presentation/*"],
    }
  },
  "include": ["src"],
  "exclude": ["node_modules", "dist"]
}